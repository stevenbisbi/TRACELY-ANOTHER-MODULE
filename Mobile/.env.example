# URL del backend — debe ser una IP alcanzable desde el celular, no localhost.
# Expo Go en celular físico: IP LAN del PC (verifica con `ipconfig`/`ifconfig`)
# Emulador de Android Studio: http://10.0.2.2:3000/api
# Simulador de iOS (Mac): http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://TU_IP_LOCAL:3000/api
